# Скопируйте в infra/.env для docker-compose, либо в apps/backend/.env для локального запуска
# backend без Docker (тогда DATABASE_URL должен указывать на доступный вам Postgres).

# --- База данных ---
POSTGRES_USER=blik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blik
DATABASE_URL=postgresql://blik:change-me@localhost:5432/blik?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=14d

# --- Master (breakglass) аккаунт ---
# Создаётся сидом (npm run prisma:seed). Роль всегда SUPER_ADMIN, source = LOCAL.
MASTER_USERNAME=master
MASTER_PASSWORD=change-me-strong-password
MASTER_FULL_NAME=Master Administrator
# Создаёт test_admin/test_intern/test_applicant (пароль TestPass123) для проверки ролей.
# НЕ включайте на проде.
SEED_TEST_ACCOUNTS=false

# --- Active Directory / LDAP ---
LDAP_URL=ldap://dc.college.local:389
LDAP_BIND_DN=CN=blik-service,OU=ServiceAccounts,DC=college,DC=local
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=college,DC=local
# DN группы AD, членство в которой даёт право подавать заявки (сотрудники/преподаватели)
LDAP_STAFF_GROUP_DN=CN=Staff,OU=Groups,DC=college,DC=local

# --- Файлы ---
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
MAX_VIDEO_UPLOAD_SIZE_MB=200

# --- Backend ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
